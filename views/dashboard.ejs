<script>
let ramChart, diskChart, cpuChart, networkChart;

function getRadialBarOptions(color, value, label) {
    return {
        series: [value],
        chart: { type: 'radialBar', height: 140 },
        plotOptions: {
            radialBar: {
                startAngle: -135,
                endAngle: 135,
                hollow: { size: '65%' },
                track: { background: 'rgba(170,184,197, 0.2)', margin: 0 },
                dataLabels: {
                    name: { show: false },
                    value: { show: true, fontSize: '20px', fontWeight: 600, offsetY: 20, formatter: (val) => val + '%' }
                }
            }
        },
        fill: { type: 'gradient', gradient: { shade: 'dark', type: 'horizontal', shadeIntensity: 0.2, opacityFrom: 1, opacityTo: 1, stops: [0, 50, 65, 91] } },
        stroke: { dashArray: 4 },
        colors: [color],
        labels: [label],
        grid: { padding: { top: 0, right: 0, bottom: 0, left: 0 } }
    };
}

function getLineChartOptions(color, data, label) {
    return {
        series: [{ name: label, data: data }],
        chart: { type: 'area', height: 200, sparkline: { enabled: true } },
        stroke: { curve: 'smooth', width: 2 },
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.1, stops: [0, 100] } },
        colors: [color],
        xaxis: { show: false },
        yaxis: { show: false },
        tooltip: { enabled: false }
    };
}

function getColor(percent, warn, danger) {
    if (percent >= danger) return '#dc3545';
    if (percent >= warn) return '#ffc107';
    return '#198754';
}

function serviceBadge(status) {
    if (status === 'active') return '<span class="badge bg-success"><i class="ri-checkbox-blank-circle-fill me-1"></i>Active</span>';
    return '<span class="badge bg-danger"><i class="ri-checkbox-blank-circle-fill me-1"></i>Inactive</span>';
}

let chartInited = false;

function initCharts() {
    cpuChart = new ApexCharts(document.querySelector('#cpu-chart'), getRadialBarOptions('#4254ba', 0, 'CPU'));
    ramChart = new ApexCharts(document.querySelector('#ram-chart'), getRadialBarOptions('#198754', 0, 'RAM'));
    diskChart = new ApexCharts(document.querySelector('#disk-chart'), getRadialBarOptions('#17a497', 0, 'Disk'));
    networkChart = new ApexCharts(document.querySelector('#network-chart'), getLineChartOptions('#4254ba', [], 'Network'));

    cpuChart.render();
    ramChart.render();
    diskChart.render();
    networkChart.render();
    chartInited = true;
}

async function refreshDashboard() {
    try {
        const res = await fetch('/api/dashboard/stats');
        const data = await res.json();

        const ram = data.server.ram;
        const disk = data.server.disk;
        const cpu = data.server.cpu;

        const ramPercent = ram.percent;
        const ramUsedGB = (ram.used / 1024 / 1024 / 1024).toFixed(1);
        const ramTotalGB = (ram.total / 1024 / 1024 / 1024).toFixed(1);

        document.getElementById('ramused').innerText = ramUsedGB + ' GB';
        document.getElementById('ramtotal').innerText = ramTotalGB + ' GB';

        const cpuPercent = cpu.percent;
        document.getElementById('cpu-model').innerText = cpu.cores + ' cores';
        document.getElementById('cpu-cores').innerText = cpu.cores + ' Cores';
        document.getElementById('load-avg').innerText = cpu.load[0].toFixed(2);

        document.getElementById('uptime').innerText = data.server.uptime;
        document.getElementById('hostname').innerText = data.server.hostname;
        document.getElementById('platform').innerText = data.server.platform.os + ' ' + data.server.platform.release.substring(0, 20);

        document.getElementById('info-hostname').innerText = data.server.hostname;
        document.getElementById('info-os').innerText = data.server.platform.os + ' ' + data.server.platform.arch;
        document.getElementById('info-cpu').innerText = cpu.model.substring(0, 40);
        document.getElementById('info-cores').innerText = cpu.cores;
        document.getElementById('info-uptime').innerText = data.server.uptime;

        document.getElementById('svc-ols').innerHTML = serviceBadge(data.services.ols.status);
        document.getElementById('svc-mariadb').innerHTML = serviceBadge(data.services.mariadb.status);
        document.getElementById('svc-redis').innerHTML = serviceBadge(data.services.redis.status);
        document.getElementById('svc-docker').innerHTML = serviceBadge(data.services.docker.status);

        if (chartInited) {
            const ramColor = getColor(ramPercent, 70, 90);
            ramChart.updateOptions({ series: [ramPercent], colors: [ramColor] });

            if (disk) {
                const diskPercent = parseFloat(disk.percent) || 0;
                const diskUsedGB = (disk.used / 1024 / 1024 / 1024).toFixed(1);
                const diskTotalGB = (disk.total / 1024 / 1024 / 1024).toFixed(1);
                document.getElementById('diskused').innerText = diskUsedGB + ' GB';
                document.getElementById('disktotal').innerText = diskTotalGB + ' GB';
                const diskColor = getColor(diskPercent, 80, 95);
                diskChart.updateOptions({ series: [diskPercent], colors: [diskColor] });
            }

            const cpuColor = getColor(cpuPercent, 60, 85);
            cpuChart.updateOptions({ series: [cpuPercent], colors: [cpuColor] });
        }

    } catch (err) {
        console.error('Dashboard refresh error:', err);
    }
}

window.addEventListener('load', function() {
    function tryInit(retries) {
        if (typeof ApexCharts !== 'undefined') {
            initCharts();
            refreshDashboard();
            setInterval(refreshDashboard, 2000);
        } else if (retries > 0) {
            setTimeout(function() { tryInit(retries - 1); }, 200);
        }
    }
    tryInit(20);
});
</script>
