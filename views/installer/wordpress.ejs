<div class="content-page">
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h4 class="page-title"><i class="ri-wordpress-fill"></i> WordPress Installer</h4>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Install WordPress</h5>

                            <form id="wpInstallForm">
                                <div class="mb-3">
                                    <label class="form-label">Select Domain <span class="text-danger">*</span></label>
                                    <select class="form-select" id="wpDomain" required>
                                        <option value="">-- Pilih Domain --</option>
                                <% if (websites.length === 0) { %>
                                            <option value="" disabled>No websites found. Create a website first.</option>
                                        <% } else { %>
                                            <% websites.forEach(function(site) { %>
                                                <option value="<%= site.domain %>" 
                                                    data-installed="<%= site.wpInstalled %>"
                                                    data-version="<%= site.wpVersion || '' %>"
                                                    data-docroot="<%= site.document_root || '/home/public_html/' + site.domain %>">
                                                    <%= site.domain %> 
                                                    <% if (site.wpInstalled) { %>
                                                        <span class="badge bg-success">WP <%= site.wpVersion %></span>
                                                    <% } %>
                                                </option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>

                                <div id="wpStatus" class="mb-3" style="display:none;">
                                    <div class="alert alert-info">
                                        <i class="ri-information-line"></i>
                                        <span id="wpStatusText"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Site Title <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="wpSiteName" required placeholder="My Website">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Admin Username <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="wpAdminUser" required placeholder="admin">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Admin Password <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input type="password" class="form-control" id="wpAdminPassword" required>
                                            <button class="btn btn-outline-secondary" type="button" onclick="generatePassword()">
                                                <i class="ri-refresh-line"></i> Generate
                                            </button>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Admin Email <span class="text-danger">*</span></label>
                                        <input type="email" class="form-control" id="wpAdminEmail" required placeholder="admin@example.com">
                                    </div>
                                </div>

                                <hr>

                                <h6 class="mb-3">Database Configuration (Optional)</h6>
                                <p class="text-muted mb-3">Leave empty to auto-create database</p>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database Name</label>
                                        <input type="text" class="form-control" id="wpDbName" placeholder="Auto: wp_domain_com">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database User</label>
                                        <input type="text" class="form-control" id="wpDbUser" placeholder="Same as DB name">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Database Password</label>
                                        <input type="text" class="form-control" id="wpDbPassword" placeholder="Auto-generated">
                                    </div>
                                </div>

                                <hr>

                                <h6 class="mb-3">Performance</h6>

                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" id="wpInstallCache" checked>
                                        <label class="form-check-label fw-bold" for="wpInstallCache">
                                            Install MR Panel Cache <span class="badge bg-success">Recommended</span>
                                        </label>
                                    </div>
                                    <div class="ms-4 mt-2" id="cacheSubOptions">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="wpCachePage" checked>
                                            <label class="form-check-label" for="wpCachePage">Page Cache</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="wpCacheBrowser" checked>
                                            <label class="form-check-label" for="wpCacheBrowser">Browser Cache</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="wpCachePhp" checked>
                                            <label class="form-check-label" for="wpCachePhp">PHP Tuning (OPcache)</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary" id="btnInstall">
                                        <i class="ri-download-line"></i> Install WordPress
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title mb-3">Installed WordPress</h5>
                            <div id="installedList">
                                <% let hasInstalled = false; %>
                                <% websites.forEach(function(site) { %>
                                    <% if (site.wpInstalled) { %>
                                        <% hasInstalled = true; %>
                                        <div class="d-flex align-items-center mb-3 p-2 border rounded">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-0"><%= site.domain %></h6>
                                                <small class="text-muted">WP <%= site.wpVersion %></small>
                                            </div>
                                            <div>
                                                <a href="http://<%= site.domain %>/wp-admin" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="ri-external-link-line"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteWp('<%= site.domain %>')">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }); %>
                                <% if (!hasInstalled) { %>
                                    <div class="text-center text-muted py-4">
                                        <i class="ri-wordpress-fill fs-1"></i>
                                        <p class="mt-2">No WordPress installed yet</p>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('wpDomain').addEventListener('change', function() {
    const opt = this.options[this.selectedIndex];
    const installed = opt.dataset.installed === 'true';
    const status = document.getElementById('wpStatus');
    const statusText = document.getElementById('wpStatusText');
    
    if (installed) {
        status.style.display = 'block';
        status.className = 'mb-3 alert alert-warning';
        statusText.innerHTML = '<i class="ri-alert-line"></i> WordPress is already installed (v' + opt.dataset.version + '). Reinstalling will overwrite files.';
    } else {
        status.style.display = 'none';
    }
    
    // Auto-fill DB name
    const domain = this.value;
    if (domain) {
        const dbName = 'wp_' + domain.replace(/\./g, '_');
        document.getElementById('wpDbName').placeholder = dbName;
    }
});

document.getElementById('wpInstallCache').addEventListener('change', function() {
    document.getElementById('cacheSubOptions').style.display = this.checked ? 'block' : 'none';
});

document.getElementById('wpInstallForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const domain = document.getElementById('wpDomain').value;
    if (!domain) return Swal.fire('Error', 'Please select a domain', 'error');
    
    const btn = document.getElementById('btnInstall');
    btn.disabled = true;
    btn.innerHTML = '<i class="ri-loader-4-line ri-spin"></i> Installing...';
    
    try {
        const res = await fetch('/api/installer/wordpress/install', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                domain,
                siteName: document.getElementById('wpSiteName').value,
                adminUser: document.getElementById('wpAdminUser').value,
                adminPassword: document.getElementById('wpAdminPassword').value,
                adminEmail: document.getElementById('wpAdminEmail').value,
                dbName: document.getElementById('wpDbName').value || undefined,
                dbUser: document.getElementById('wpDbUser').value || undefined,
                dbPassword: document.getElementById('wpDbPassword').value || undefined,
                installCache: document.getElementById('wpInstallCache').checked,
                cacheOptions: {
                    page: document.getElementById('wpCachePage').checked,
                    browser: document.getElementById('wpCacheBrowser').checked,
                    php: document.getElementById('wpCachePhp').checked,
                }
            })
        });
        
        const data = await res.json();
        
        if (data.error) {
            Swal.fire('Error', data.error, 'error');
        } else if (data.method === 'wp-cli') {
            let msg = '<b>WordPress installed successfully!</b>';
            msg += '<hr class="my-2">';
            msg += '<b>Admin URL:</b> <a href="http://' + domain + '/wp-admin" target="_blank">http://' + domain + '/wp-admin</a>';
            msg += '<br><b>Username:</b> ' + document.getElementById('wpAdminUser').value;
            msg += '<br><b>Password:</b> ' + document.getElementById('wpAdminPassword').value;
            if (data.db) {
                msg += '<hr class="my-2">';
                msg += '<small class="text-muted"><b>DB:</b> ' + data.db.name + ' | <b>User:</b> ' + data.db.user + ' | <b>Pass:</b> ' + data.db.password + '</small>';
            }
            if (data.cache && data.cache.installed) {
                msg += '<hr class="my-2">';
                msg += '<span class="text-success"><i class="ri-check-line"></i> MR Panel Cache: Active</span>';
            } else if (data.cache && data.cache.error) {
                msg += '<hr class="my-2">';
                msg += '<span class="text-warning"><i class="ri-alert-line"></i> MR Panel Cache: ' + data.cache.error + '</span>';
            }
            Swal.fire({
                title: 'WordPress Installed!',
                html: msg,
                icon: 'success',
                width: 600,
                confirmButtonText: 'Open Admin Panel',
                showCancelButton: true,
                cancelButtonText: 'Close'
            }).then((result) => {
                if (result.isConfirmed) window.open('http://' + domain + '/wp-admin', '_blank');
                location.reload();
            });
        } else {
            let msg = '<b>WordPress files installed.</b>';
            msg += '<br>Please complete the installation at:<br>';
            msg += '<a href="' + data.installUrl + '" target="_blank">' + data.installUrl + '</a>';
            if (data.wpCliError) {
                msg += '<hr class="my-2"><small class="text-danger">WP-CLI Error: ' + data.wpCliError + '</small>';
            }
            if (data.db) {
                msg += '<hr class="my-2">';
                msg += '<small class="text-muted"><b>DB:</b> ' + data.db.name + ' | <b>User:</b> ' + data.db.user + ' | <b>Pass:</b> ' + data.db.password + '</small>';
            }
            Swal.fire({
                title: 'Install via Browser',
                html: msg,
                icon: 'info',
                width: 600,
                confirmButtonText: 'Open Install Page',
                showCancelButton: true,
                cancelButtonText: 'Close'
            }).then((result) => {
                if (result.isConfirmed) window.open(data.installUrl, '_blank');
                location.reload();
            });
        }
        }
    } catch (err) {
        Swal.fire('Error', err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="ri-download-line"></i> Install WordPress';
    }
});

function generatePassword() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*';
    let pass = '';
    for (let i = 0; i < 16; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
    document.getElementById('wpAdminPassword').value = pass;
}

async function deleteWp(domain) {
    const result = await Swal.fire({
        title: 'Delete WordPress?',
        text: 'This will delete all WordPress files from ' + domain,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'Yes, delete'
    });
    
    if (result.isConfirmed) {
        try {
            const res = await fetch('/api/installer/wordpress/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ domain })
            });
            const data = await res.json();
            
            if (data.error) {
                Swal.fire('Error', data.error, 'error');
            } else {
                Swal.fire('Deleted!', 'WordPress has been removed.', 'success').then(() => location.reload());
            }
        } catch (err) {
            Swal.fire('Error', err.message, 'error');
        }
    }
}
</script>
