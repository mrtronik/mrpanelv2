  <div class="content">
                    <div class="container-fluid">

                        <div class="row">
                            <div class="col-12">
                                <div class="page-title-box justify-content-between d-flex align-items-lg-center flex-lg-row flex-column">
                                    <h4 class="page-title"><i class="ri-global-line me-2"></i>Websites</h4>
                                    <div class="d-flex align-items-center gap-2">
                                        <a href="/websites/add" class="btn btn-primary btn-sm">
                                            <i class="ri-add-line me-1"></i> Add Website
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-body p-0">
                                        <% if (websites.length === 0) { %>
                                        <div class="text-center py-5">
                                            <i class="ri-global-line text-muted" style="font-size: 3rem;"></i>
                                            <h5 class="mt-3">No websites yet</h5>
                                            <p class="text-muted">Click "Add Website" to create your first website.</p>
                                        </div>
                                        <% } else { %>
                                        <div class="table-responsive">
                                            <table class="table table-hover table-centered mb-0">
                                                <thead class="bg-light-subtle">
                                                    <tr>
                                                        <th>Domain</th>
                                                        <th>Document Root</th>
                                                        <th>PHP</th>
                                                        <th>Status</th>
                                                        <th>SSL</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% websites.forEach(function(site) { %>
                                                    <tr>
                                                        <td>
                                                            <a href="/websites/<%= site.id %>" class="fw-semibold text-decoration-none">
                                                                <i class="ri-global-line text-primary me-1"></i> <%= site.domain %>
                                                            </a>
                                                        </td>
                                                        <td><code class="text-muted"><%= site.document_root %></code></td>
                                                        <td><span class="badge bg-info-subtle text-info"><%= site.php_version %></span></td>
                                                        <td>
                                                            <% if (site.status === 'active') { %>
                                                                <span class="badge bg-success"><i class="ri-checkbox-blank-circle-fill me-1"></i>Active</span>
                                                            <% } else if (site.status === 'suspended') { %>
                                                                <span class="badge bg-warning"><i class="ri-checkbox-blank-circle-fill me-1"></i>Suspended</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary"><i class="ri-checkbox-blank-circle-fill me-1"></i>Pending</span>
                                                            <% } %>
                                                        </td>
                                                        <td>
                                                            <% if (site.ssl_status === 'active') { %>
                                                                <span class="badge bg-success"><i class="ri-lock-fill me-1"></i>Active</span>
                                                            <% } else { %>
                                                                <span class="badge bg-secondary">None</span>
                                                            <% } %>
                                                        </td>
                                                        <td class="text-end">
                                                            <a href="/websites/<%= site.id %>" class="btn btn-sm btn-outline-primary">
                                                                <i class="ri-settings-3-line"></i>
                                                            </a>
                                                            <% if (site.status === 'active') { %>
                                                            <form action="/websites/<%= site.id %>/suspend" method="POST" class="d-inline">
                                                                <button class="btn btn-sm btn-outline-warning" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Suspend this website?')">
                                                                    <i class="ri-pause-line"></i>
                                                                </button>
                                                            </form>
                                                            <% } else { %>
                                                            <form action="/websites/<%= site.id %>/activate" method="POST" class="d-inline">
                                                                <button class="btn btn-sm btn-outline-success">
                                                                    <i class="ri-play-line"></i>
                                                                </button>
                                                            </form>
                                                            <% } %>
                                                            <form action="/websites/<%= site.id %>/delete" method="POST" class="d-inline">
                                                                <button class="btn btn-sm btn-outline-danger" onclick="event.preventDefault(); confirmDelete(this.closest('form'), 'Delete this website? This cannot be undone.')">
                                                                    <i class="ri-delete-bin-line"></i>
                                                                </button>
                                                            </form>
                                                        </td>
                                                    </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
